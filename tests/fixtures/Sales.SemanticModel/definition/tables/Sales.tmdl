/// One row per order line.
table Sales
	lineageTag: 6f0c2a51-0001-4000-8000-000000000001

	/// Total revenue in EUR.
	measure Revenue = SUM(Sales[Amount])
		formatString: #,0.00
		displayFolder: KPIs
		lineageTag: 6f0c2a51-0001-4000-8000-000000000101

	measure 'Margin %' =
			VAR revenue = [Revenue]

			RETURN
				DIVIDE(revenue - SUM(Sales[Cost]), revenue)
		formatString: 0.00%
		lineageTag: 6f0c2a51-0001-4000-8000-000000000102

	column OrderID
		dataType: int64
		isKey
		formatString: 0
		lineageTag: 6f0c2a51-0001-4000-8000-000000000201
		summarizeBy: none
		sourceColumn: OrderID

		annotation SummarizationSetBy = Automatic

	column OrderDate
		dataType: dateTime
		formatString: Long Date
		lineageTag: 6f0c2a51-0001-4000-8000-000000000202
		summarizeBy: none
		sourceColumn: OrderDate

		variation Variation
			isDefault
			relationship: 6f0c2a51-0001-4000-8000-000000000904
			defaultHierarchy: LocalDateTable_0001.'Date Hierarchy'

		annotation SummarizationSetBy = Automatic

		annotation UnderlyingDateTimeDataType = Date

	column CustomerKey
		dataType: int64
		isHidden
		formatString: 0
		lineageTag: 6f0c2a51-0001-4000-8000-000000000203
		summarizeBy: none
		sourceColumn: CustomerKey

	column BillToCustomerKey
		dataType: int64
		isHidden
		formatString: 0
		lineageTag: 6f0c2a51-0001-4000-8000-000000000204
		summarizeBy: none
		sourceColumn: BillToCustomerKey

	column ProductKey
		dataType: string
		lineageTag: 6f0c2a51-0001-4000-8000-000000000205
		summarizeBy: none
		sourceColumn: ProductKey

	column Amount
		dataType: decimal
		formatString: #,0.00
		lineageTag: 6f0c2a51-0001-4000-8000-000000000206
		summarizeBy: sum
		sourceColumn: Amount

	column Cost
		dataType: double
		lineageTag: 6f0c2a51-0001-4000-8000-000000000207
		summarizeBy: sum
		sourceColumn: Cost

	/// Amount minus cost, per order line.
	column 'Gross Profit' = [Amount] - [Cost]
		dataType: decimal
		displayFolder: Profitability
		lineageTag: 6f0c2a51-0001-4000-8000-000000000208
		summarizeBy: sum

	partition Sales = m
		mode: import
		source =
				let
					Source = Sql.Database("sql.example.com", "SalesDW"),
					dbo_FactSales = Source{[Schema="dbo",Item="FactSales"]}[Data]
				in
					dbo_FactSales

	annotation PBI_ResultType = Table

