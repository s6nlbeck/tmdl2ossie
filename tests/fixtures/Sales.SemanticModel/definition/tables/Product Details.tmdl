		summarizeBy: none
		sourceColumn: ProductKey

	column Category
		dataType: string
		lineageTag: 6f0c2a51-0001-4000-8000-000000000502
		summarizeBy: none
		sourceColumn: Category

	column Subcategory
		dataType: string
		lineageTag: 6f0c2a51-0001-4000-8000-000000000503
